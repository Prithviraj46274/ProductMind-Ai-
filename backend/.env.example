# ==============================================================================
# ProductMind AI — Python Backend & Database Environment Configuration
# ==============================================================================

# MongoDB Connection String (Local development standalone/replica set or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/productmind_ai
DATABASE_NAME=productmind_ai

# MongoDB Atlas Alternative URI (uncomment for Atlas cloud connection)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/productmind_ai?retryWrites=true&w=majority

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Retention Policies (in days)
ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=180
AUTH_SESSION_RETENTION_DAYS=30

