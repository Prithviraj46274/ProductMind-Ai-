# ==============================================================================
# ProductMind AI — Python Backend & Database Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection String (Exclusive Database — Local MongoDB is disabled)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/productmind_ai?retryWrites=true&w=majority
DATABASE_NAME=productmind_ai
MONGODB_DATABASE=productmind_ai

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Retention Policies (in days)
ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=180
AUTH_SESSION_RETENTION_DAYS=30

# ==============================================================================
# AI & LLM Configuration (Groq / Google Gemini / OpenRouter via LangChain)
# ==============================================================================
# Supported providers: 'groq', 'google', or 'openrouter'
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_TEMPERATURE=1.0
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Groq Configuration (Used when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key

# OpenRouter Configuration (Used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Gemini Configuration (Used when AI_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key
