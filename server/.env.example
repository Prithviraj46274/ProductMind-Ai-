# ==============================================================================
# ProductMind AI — Backend & Database Configuration
# ==============================================================================

# MongoDB Connection String (Local development replica set or Atlas cluster)
# For local standalone / docker:
MONGODB_URI=mongodb://127.0.0.1:27017/productmind_ai

# For MongoDB Atlas with Vector Search:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/productmind_ai?retryWrites=true&w=majority

# Application Environment
NODE_ENV=development
PORT=5000

# Client Application URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# JWT & Authentication Secrets (Required for production session signing)
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Maximum Database Pool Size
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Analytics & Audit Retention Configuration (Days)
ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=180
AUTH_SESSION_RETENTION_DAYS=30
